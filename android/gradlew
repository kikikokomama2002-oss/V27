#!/usr/bin/env sh
#
# Standard Gradle wrapper launch script. This delegates to the Gradle
# distribution declared in gradle/wrapper/gradle-wrapper.properties.
# The gradle-wrapper.jar binary itself is NOT included in this scaffold
# (binary files aren't practical to hand-author) — see INSTRUCTIONS.md:
# running `gradle wrapper` once (or `flutter create .` merge) regenerates
# it automatically, and standard CI images already have Gradle available
# to bootstrap it.

DEFAULT_JVM_OPTS='-Xmx64m -Xms64m'

APP_HOME=$(cd "$(dirname "$0")" && pwd)

warn () {
    echo "$*"
}

die () {
    echo "$*"
    exit 1
}

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
EXPECTED_WRAPPER_SHA256="81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"
if [ ! -f "$WRAPPER_JAR" ]; then
    BOOTSTRAP="$APP_HOME/gradle/wrapper/bootstrap-wrapper.sh"
    if [ ! -x "$BOOTSTRAP" ]; then
        chmod +x "$BOOTSTRAP"
    fi
    "$BOOTSTRAP"
fi

if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_WRAPPER_SHA256=$(sha256sum "$WRAPPER_JAR" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
    ACTUAL_WRAPPER_SHA256=$(shasum -a 256 "$WRAPPER_JAR" | awk '{print $1}')
else
    die "error: sha256sum/shasum is required to verify gradle-wrapper.jar"
fi
if [ "$ACTUAL_WRAPPER_SHA256" != "$EXPECTED_WRAPPER_SHA256" ]; then
    die "error: gradle-wrapper.jar checksum mismatch (expected $EXPECTED_WRAPPER_SHA256, got $ACTUAL_WRAPPER_SHA256)"
fi
CLASSPATH="$WRAPPER_JAR"

exec "$JAVACMD" $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
